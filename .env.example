# Скопируйте в .env и при необходимости заполните. Секреты в git не коммитим.
WEB_PORT=3000
API_PORT=8080
# Необязательно: LLM-советчик по находкам (POST /advice). Без ключа выключен, остальное работает.
ANTHROPIC_API_KEY=
# Необязательно: модель Claude для советчика (по умолчанию — из ClaudeAdvisor)
ANTHROPIC_MODEL=
