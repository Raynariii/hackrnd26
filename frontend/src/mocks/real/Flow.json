{"file":"Flow.java","source":"import java.io.*;\nimport java.util.*;\n\npublic class Flow {\n    static int grade(int score) {\n        if (score >= 90) {\n            return 5;\n        } else if (score >= 75) {\n            return 4;\n        } else {\n            System.out.println(\"low\");\n        }\n        return 3;\n    }\n\n    static String day(int d) {\n        String name = \"?\";\n        switch (d) {\n            case 1:\n                name = \"Пн\";\n                break;\n            case 2:\n            case 3:\n                name = \"Вт/Ср\";\n                break;\n        }\n        return name;\n    }\n\n    static int readAll(BufferedReader in) {\n        int total = 0;\n        try {\n            while (true) {\n                String line = in.readLine();\n                if (line == null) break;\n                if (line.isBlank()) continue;\n                total += Integer.parseInt(line.trim());\n            }\n        } catch (IOException e) {\n            System.err.println(\"io: \" + e.getMessage());\n        } catch (NumberFormatException e) {\n            throw new IllegalArgumentException(\"bad number\", e);\n        } finally {\n            System.out.println(\"done\");\n        }\n        return total;\n    }\n\n    static int pairs(int[][] grid) {\n        int count = 0;\n        outer:\n        for (int i = 0; i < grid.length; i++) {\n            for (int j = 0; j < grid[i].length; j++) {\n                if (grid[i][j] < 0) break outer;\n                if (grid[i][j] == 0) continue;\n                count++;\n            }\n        }\n        do {\n            count--;\n        } while (count > 100);\n        return count;\n    }\n}\n","overview":{"level":"overview","scope":null,"nodes":[{"id":"ga8","astId":"a8","kind":"class","label":"Flow","code":null,"range":{"file":"Flow.java","startLine":4,"endLine":64,"startColumn":1,"endColumn":1},"parent":null,"findings":[],"meta":{}},{"id":"ga11","astId":"a11","kind":"method","l